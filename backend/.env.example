# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Free MongoDB Atlas or Local MongoDB)
# For Atlas, replace with your URI: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/apexlib?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/apexlib

# JWT Secret Key (Minimum 32 characters)
JWT_SECRET=apexlib_secure_jwt_secret_production_key_2026_super_safe
JWT_EXPIRES_IN=7d

# Initial Demo Accounts Configuration
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@library.local
ADMIN_PASSWORD=Admin@123456
